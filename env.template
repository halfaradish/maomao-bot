ENVIRONMENT=dev
DRIVER=~fastapi
HOST=0.0.0.0
PORT=
SUPERUSERS=[""]

COMMAND_START=["/", ""]

##### QQ控制 #####
QQ_CONTROL_HOST=
QQ_CONTROL_PORT=
QQ_CONTROL_TOKEN=

##### NoneBot Token #####
ONEBOT_ACCESS_TOKEN=
# diting api access token
DITING_API_ACCESS_TOKEN=

##### MySQL #####
# icpc
ICPC_DB_HOST=
ICPC_DB_USER=
ICPC_DB_PASSWORD=
ICPC_DB_NAME=
ICPC_DB_PORT=
ICPC_DB_POOL_SIZE=20
# DiTingBot
BOT_DB_HOST=
BOT_DB_USER=
BOT_DB_PASSWORD=
BOT_DB_NAME=
BOT_DB_PORT=
BOT_DB_POOL_SIZE=20

### redis配置 ###
NEW_OJ_REDIS_HOST=
NEW_OJ_REDIS_PORT=
NEW_OJ_REDIS_PASSWORD=
NEW_OJ_REDIS_DB=0
NEW_OJ_REDIS_MAX_CONNECTIONS=20
NEW_OJ_REDIS_SOCKET_TIMEOUT=5
NEW_OJ_REDIS_SOCKET_CONNECT_TIMEOUT=5
NEW_OJ_REDIS_DECODE_RESPONSES=false
NEW_OJ_REDIS_RETRY_ON_TIME=true
NEW_OJ_REDIS_HEALTH_CHECK_INTERVAL=30


### 数据目录 ###
# nonebot 数据目录
NONEBOT_DATA_DIR=
# napcat 数据目录
DATA_DIR=
# sql语句存放目录
SQL_DIR=
# 图片存放目录
IMAGES_DIR=
# 压缩图片存放目录
IMAGES_COMPRESSED_DIR=
# 过题图片存放目录
SUB_RANKING_DIR=
# 图片收藏存放目录
IMAGE_COLLECTION_STORAGE_DIR=

# 是否开启 Prometheus 插件
PROMETHEUS_ENABLE=true
# Prometheus 挂载地址
PROMETHEUS_METRICS_PATH=/metrics
# 限制聊天查询命令只能管理员使用，默认 true
PROMETHEUS_CHAT_NEEDS_ADMIN=true

###############################
#   本 地  插 件 变 量 配 置   #
###############################

##### check_up 考勤插件 #####
# 表示第一天的八点
DAY_START=8
# 表示第二天的两点
DAY_END=2
# 定时发送的时间
TIMING_HOUR=10
TIMING_MINUTE=30
TIMING_SECOND=00

### sleep 随机延迟回复插件 ###
DELAY_ENABLED=true
# 最短睡眠时间
MIN_SLEEP_TIME=0.3
# 最长睡眠时间
MAX_SLEEP_TIME=1.0


##### ack 插件 #####
ACK_ENABLED=true
ACK_COMMAND_PREFIX=!ACK
ANN_COMMAND_PREFIX=!ANN


### 消息可持久化插件 ###
LOGGING_INFO_PRIORITY=114
LOGGING_INFO_BLOCK=false

##### 司契权限系统 (siqi_auth) #####
# auth_server 或 auth_agent 的地址（Docker 容器内用 host.docker.internal 访问宿主机）
SIQI_AUTH_HOST=host.docker.internal
# 端口：8888=auth_server(直连主库)，8881=auth_agent(本地从库，更快)
SIQI_AUTH_PORT=8888
# 应用代码（在司契管理后台创建的应用标识）
SIQI_AUTH_APP_CODE=qq_bot
# HTTP 请求超时（秒）
SIQI_AUTH_TIMEOUT=2
# 是否启用司契权限系统（false 时回退到本地白名单）
SIQI_AUTH_ENABLED=true

##### 这就是VV 表情包插件 (vv) #####
# 台词文本匹配度下限（0-100，越高要求越精确）
VV_MIN_RATIO=50.0
# 人脸相似度下限（0-1，保证画面中是 VV 本人）
VV_MIN_SIMILARITY=0.5

##### 文件日志配置 (logger.add) #####
# 日志文件路径（支持 loguru 的路径格式）
LOG_FILE_PATH=logs/nonebot.log
# 日志轮转时间（同 loguru rotation 参数，如 "00:00" 每天午夜、"500 MB" 按大小）
LOG_FILE_ROTATION=00:00
# 日志保留天数（同 loguru retention 参数）
LOG_FILE_RETENTION=7 days
# 文件日志级别（区别于 nonebot 控制台日志的 LOG_LEVEL）
LOG_FILE_LEVEL=DEBUG
# 日志文件编码
LOG_FILE_ENCODING=utf-8
# 是否启用异步队列写入（true/false）
LOG_FILE_ENQUEUE=true
# 日志压缩格式（如 zip、gz、bz2，或留空不压缩）
LOG_FILE_COMPRESSION=zip

##### 插件使用频率统计 (plugin_usage_stats) #####
# 是否启用插件使用统计（默认 false；生产/测试共用数据库时建议仅生产开启）
PLUGIN_USAGE_STATS_ENABLE=false
# 排除的插件短名（逗号分隔），命中的插件触发不计入统计
PLUGIN_USAGE_STATS_EXCLUDED=plugin_usage_stats,logging_info
# 查询榜单默认条数上限
PLUGIN_USAGE_STATS_TOP_N=15
# 使用明细保留天数（超过后每日 05:00 自动清理）
PLUGIN_USAGE_STATS_RETENTION_DAYS=365

##### 热重载 #####
# true 时 bot.py 变成 watcher，监视 src/、bot.py、.env* 并自动重启 worker
# 部署执行器会在改写工作区期间写 data/deploy/pull.lock 让 watcher 推迟重启，
# 避免加载到「git 逐个落盘」的半同步代码
HOT_RELOAD=false

###############################
#   谛听部署 (diting_deploy)   #
###############################
# QQ 命令 /diting pull|build|restart|status|log：插件只做鉴权/受理/回报，
# 真正的 git 与 docker 操作由宿主机 scripts/diting-agent.sh 完成（见 docs/diting-deploy.md）
# 是否启用本插件（false 时只留一个禁用存根，不注册任何命令）
DITING_DEPLOY_ENABLED=true
# 部署目标分支。**唯一的分支来源**，命令不接受分支参数；留空则拒绝 pull/build
# 生产目录填 master，开发目录填 dev/1.0
DITING_DEPLOY_BRANCH=master
# 命令名。**保持默认 diting 不要加前缀**：COMMAND_START 会自动补前缀，
# COMMAND_START=["dev-"] 时命令自然就是 dev-diting；这里填 dev-diting 会变成 dev-dev-diting
DITING_DEPLOY_CMD=diting
# 命令优先级与是否阻断后续 matcher
DITING_DEPLOY_PRIORITY=5
DITING_DEPLOY_BLOCK=true
# 队列根目录，留空用 ${DATA_DIR}/deploy（必须与宿主机执行器看到的是同一目录）
DITING_DEPLOY_QUEUE_DIR=
# build / restart 的二次确认令牌有效期（秒）
DITING_DEPLOY_CONFIRM_TTL=60
# 同一用户改动类命令的冷却（秒）
DITING_DEPLOY_USER_COOLDOWN=30
# 等待宿主机执行器认领作业的上限（秒），超时明确回报「agent 未响应」
DITING_DEPLOY_ACCEPT_TIMEOUT=90
# 要求 state.json 心跳不早于该秒数；0 表示不要求（只装 .path 不装 .timer 时可设 0）
DITING_DEPLOY_REQUIRE_AGENT_FRESH=600
# /diting log 返回的日志尾部行数（较长时用合并转发消息发，不受 QQ 单条消息长度限制）
DITING_DEPLOY_LOG_TAIL_LINES=200
# 合并转发里每个节点承载的字符数
DITING_DEPLOY_FORWARD_CHARS_PER_NODE=1500
# 合并转发最多几个节点；超出时从最旧的日志开始丢（尾部才是报错信息）
DITING_DEPLOY_FORWARD_MAX_NODES=15
# 非 0 时把所有部署事件额外镜像到该群号
DITING_DEPLOY_NOTIFY_GROUP=0
# 启动时自动创建的权限组名（超管用 perm 绑定 群 <群号> <该名> 即可授权）
DITING_DEPLOY_PERM_GROUP=diting_deploy

