###############################
#   本 地  插 件 变 量 配 置   #
###############################

##### check_up 考勤插件 #####
# 表示第一天的八点
DAY_START=8
# 表示第二天的两点
DAY_END=2
# 定时发送的时间
TIMING_HOUR=10
TIMING_MINUTE=30
TIMING_SECOND=00

### sleep 随机延迟回复插件 ###
DELAY_ENABLED=true
# 最短睡眠时间
MIN_SLEEP_TIME=0.3
# 最长睡眠时间
MAX_SLEEP_TIME=1.0


##### ack 插件 #####
ACK_ENABLED=true
ACK_COMMAND_PREFIX=!ACK
ANN_COMMAND_PREFIX=!ANN


### 消息可持久化插件 ###
LOGGING_INFO_PRIORITY=114
LOGGING_INFO_BLOCK=false

##### 司契权限系统 (siqi_auth) #####
# auth_server 或 auth_agent 的地址（Docker 容器内用 host.docker.internal 访问宿主机）
SIQI_AUTH_HOST=host.docker.internal
# 端口：8888=auth_server(直连主库)，8881=auth_agent(本地从库，更快)
SIQI_AUTH_PORT=8888
# 应用代码（在司契管理后台创建的应用标识）
SIQI_AUTH_APP_CODE=qq_bot
# HTTP 请求超时（秒）
SIQI_AUTH_TIMEOUT=2
# 是否启用司契权限系统（false 时回退到本地白名单）
SIQI_AUTH_ENABLED=true

##### 这就是VV 表情包插件 (vv) #####
# 台词文本匹配度下限（0-100，越高要求越精确）
VV_MIN_RATIO=50.0
# 人脸相似度下限（0-1，保证画面中是 VV 本人）
VV_MIN_SIMILARITY=0.5

##### 文件日志配置 (logger.add) #####
# 日志文件路径（支持 loguru 的路径格式）
LOG_FILE_PATH=logs/nonebot.log
# 日志轮转时间（同 loguru rotation 参数，如 "00:00" 每天午夜、"500 MB" 按大小）
LOG_FILE_ROTATION=00:00
# 日志保留天数（同 loguru retention 参数）
LOG_FILE_RETENTION=7 days
# 文件日志级别（区别于 nonebot 控制台日志的 LOG_LEVEL）
LOG_FILE_LEVEL=DEBUG
# 日志文件编码
LOG_FILE_ENCODING=utf-8
# 是否启用异步队列写入（true/false）
LOG_FILE_ENQUEUE=true
# 日志压缩格式（如 zip、gz、bz2，或留空不压缩）
LOG_FILE_COMPRESSION=zip

##### 插件使用频率统计 (plugin_usage_stats) #####
# 是否启用插件使用统计（默认 false；生产/测试共用数据库时建议仅生产开启）
PLUGIN_USAGE_STATS_ENABLE=false
# 排除的插件短名（逗号分隔），命中的插件触发不计入统计
PLUGIN_USAGE_STATS_EXCLUDED=plugin_usage_stats,logging_info
# 查询榜单默认条数上限
PLUGIN_USAGE_STATS_TOP_N=15
# 使用明细保留天数（超过后每日 05:00 自动清理）
PLUGIN_USAGE_STATS_RETENTION_DAYS=365

##### 全局邮件工具（src/common/email_sender.py） #####
# 默认关闭；填入发件配置后再开启，不要提交真实授权码。
# 环境变量 / .env 已有同名配置时，.env.prod / .env.dev 不会覆盖它。
EMAIL_ENABLED=false
# true 时只构建并校验邮件，不连接 SMTP、不记录正文和授权码。
EMAIL_DRY_RUN=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
# ssl=连接时加密；starttls=建立连接后升级加密（通常配合 587）。
SMTP_SECURITY=ssl
SMTP_USERNAME=
# QQ 邮箱使用 SMTP 授权码，而不是 QQ 登录密码。
SMTP_PASSWORD=
# 留空时使用 SMTP_USERNAME；需要与发件服务允许的地址一致。
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=谛听机器人
# 每次网络操作超时秒数；不是整封邮件的总超时。
SMTP_TIMEOUT=10
# MIME 编码后的邮件总大小上限，含附件；默认 20 MiB。
EMAIL_MAX_MESSAGE_BYTES=20971520
# 发送历史与去重记录（独立 SQLite，不使用业务 MySQL）。相对路径以工作目录为准。
# Docker 中默认 /app/data/email_delivery.sqlite3，须保留 /app/data 的持久化挂载。
EMAIL_RECORD_DB=data/email_delivery.sqlite3
# 每个进程的邮件专用线程数、等待队列容量；修改后重启生效，队列满会明确返回未发送。
EMAIL_WORKERS=2
EMAIL_QUEUE_SIZE=20
# 同一记录库内，每个窗口最多允许的 SMTP 尝试次数（重试也计数）。
EMAIL_RATE_COUNT=30
EMAIL_RATE_WINDOW=60
# 单个收件人 / 业务限流标识的次数和窗口秒数；防止反复申请刷邮件。
EMAIL_RECIPIENT_RATE_COUNT=3
EMAIL_RECIPIENT_RATE_WINDOW=3600
# 包含首次发送，最多尝试 3 次；仅对确定未投递的临时故障重试。
EMAIL_RETRY_ATTEMPTS=3
# 首次重试等待秒数，之后指数退避；不重试投递结果不确定的请求。
EMAIL_RETRY_DELAY=1

##### 群哨兵待人工复核邮件 #####
# 保留原 GROUP_SENTINEL_ENABLED 和群权限绑定逻辑。
# 同时启用 EMAIL_ENABLED 和本开关后，在初审未通过、申请挂起时发邮件，不自动拒绝。
GROUP_SENTINEL_EMAIL_ENABLED=false
GROUP_SENTINEL_EMAIL_SUBJECT=入群申请待人工复核
GROUP_SENTINEL_EMAIL_CONTACT=群主 QQ：1950482412
# true 时发送 HTML + 纯文本双版本，false 时只发纯文本。
GROUP_SENTINEL_EMAIL_HTML=false
