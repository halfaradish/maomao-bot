[Unit]
Description=DiTing 部署执行器心跳与兜底排空
Documentation=file://@DITING_DEPLOY_ROOT@/docs/diting-deploy.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-@DITING_AGENT_ENV_FILE@
ExecStart=/bin/bash @DITING_DEPLOY_ROOT@/scripts/diting-agent.sh tick
# tick 是 heartbeat + drain（见脚本里的 cmd_tick），所以它同样可能真的跑一次完整
# 构建 —— 超时不能按心跳的量级给。理由与 diting-agent.service 的 TimeoutStartSec 相同：
# 到点 SIGTERM 掉整个 cgroup，作业会连终态都写不出来。
TimeoutStartSec=7200
Nice=5
