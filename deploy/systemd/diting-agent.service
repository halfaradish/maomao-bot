[Unit]
Description=DiTing 部署执行器（处理 QQ 下发的 pull / build / restart 作业）
Documentation=file://@DITING_DEPLOY_ROOT@/docs/diting-deploy.md
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-@DITING_AGENT_ENV_FILE@
# 以 root 运行是刻意的：容器内也是 root，跨 uid 会写不动对方创建的 data/deploy/* 目录
# （部署目录已由 install.sh 置为 0777 兜底，但 root 是这里最省事也最一致的边界）
ExecStart=/bin/bash @DITING_DEPLOY_ROOT@/scripts/diting-agent.sh drain
# 必须大于一次冷构建的耗时。Type=oneshot 的 TimeoutStartSec 是整条作业的预算，
# 到点 systemd 会给整个 cgroup 发 SIGTERM，执行器来不及写终态：status 永远停在
# running/rebuild、running/ 留下残留（后续作业被判「已有任务在执行」），QQ 里也
# 不会有任何回复。实测一次全量重建（apt + pip + playwright 浏览器）约 28 分钟，
# 所以这里给 2 小时；极慢网络下若确实可能更久，再往上调。
TimeoutStartSec=7200
Nice=5
