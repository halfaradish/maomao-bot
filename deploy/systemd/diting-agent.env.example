# DiTing 部署执行器配置
# 安装位置：/etc/default/diting-agent
#           （用 install.sh --name dev 装第二个实例时是 /etc/default/diting-agent-dev）
# 由 diting-agent.service / diting-agent-tick.service 通过 EnvironmentFile 读取。
# 改完执行：systemctl daemon-reload（改本文件其实不必，但无害）；不需要重启服务，
# 下一次触发（队列有新作业或 5 分钟心跳）就会带上新配置。

# 目标环境：prod 或 dev。留空则读 <仓库>/.env 的 ENVIRONMENT。
# 严禁填 local：docker-manager.sh 会把 local 映射成生产档位（容器 diting-nonebot、6090）
# 却挂载 .env.local，档位与配置错配，执行器会直接拒绝作业。
# DITING_DEPLOY_ENV=prod

# 构建模式：
#   auto   默认。对 requirements.txt / Dockerfile / pyproject.toml / poetry.lock /
#          entrypoint.sh / webui 整棵树求指纹，未变且镜像存在则跳过重建，只重启。
#   always 每次 /diting build 都重建镜像。
# DITING_DEPLOY_BUILD_MODE=auto

# 等热重载把 worker 拉起的上限秒数（仅 pull 用；超时会判作业失败并附日志）
# DITING_DEPLOY_RELOAD_TIMEOUT=120

# 重启后等 HTTP 就绪的上限秒数
# DITING_DEPLOY_HEALTH_TIMEOUT=120

# git fetch / checkout 的超时秒数
# DITING_DEPLOY_GIT_TIMEOUT=300

# 设为 1 时允许在工作区有未提交改动的情况下执行（git checkout -f 会丢弃这些改动）
# DITING_DEPLOY_ALLOW_DIRTY=0

# 设为 1 时只走预检与状态写入，不碰 git / docker（本地验证协议用）
# DITING_DEPLOY_DRY_RUN=0

# 设为 0 时心跳不做 git ls-remote（省一次网络往返，但 state.json 里看不到落后提交数）
# DITING_DEPLOY_HEARTBEAT_REMOTE=1
