# 排除所有 .git 目录
**/.git

# 排除模型文件（运行时通过 volume mount 挂载）
**/sell_ad_group_model/

# 排除日志文件
*.log

# 排除特定文件夹
node_modules/
tmp/
.venv/

# 排除 Python 缓存
**/__pycache__/
*.pyc

# 排除 IDE 配置
.idea/

scripts/
data/

# webui source (only needed at build time in Docker)
webui/src/
webui/package.json
webui/package-lock.json
webui/vite.config.js

# webui build artifacts (let Docker produce fresh)
webui/dist/

# vite dev cache
webui/.vite/